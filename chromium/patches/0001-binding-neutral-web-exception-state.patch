++#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_WEB_EXCEPTION_TO_V8_H_
++#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_WEB_EXCEPTION_TO_V8_H_
++
++#include "third_party/blink/renderer/platform/bindings/exception_state.h"
++#include "third_party/blink/renderer/platform/bindings/web_exception_state.h"
++
++namespace blink {
++
++// V8 is one consumer of the binding-neutral result. Native TypeScript uses a
++// separate adapter and never calls this function.
++inline void PropagateWebExceptionToV8(const WebExceptionState& source,
++                                      ExceptionState& target) {
++  switch (source.GetKind()) {
++    case WebExceptionState::Kind::kNone:
++      return;
++    case WebExceptionState::Kind::kDOMException:
++      target.ThrowDOMException(source.DOMCode(), source.Message());
++      return;
++    case WebExceptionState::Kind::kSecurityError:
++      target.ThrowSecurityError(source.Message(), source.UnsanitizedMessage());
++      return;
++    case WebExceptionState::Kind::kRangeError:
++      target.ThrowRangeError(source.Message());
++      return;
++    case WebExceptionState::Kind::kTypeError:
++      target.ThrowTypeError(source.Message());
++      return;
++    case WebExceptionState::Kind::kSyntaxError:
++      target.ThrowSyntaxError(source.Message());
++      return;
++  }
++}
++
++}  // namespace blink
++
++#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_WEB_EXCEPTION_TO_V8_H_
